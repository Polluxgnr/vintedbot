# Clé OpenRouter pour l'IA (triage ambigu, vision top-K) — optionnel
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Désactiver l'IA (heuristiques seules)
# VF_NO_AI=1

# Logs détaillés
# VF_VERBOSE=1

# Scrapers — timeouts bootstrap (secondes)
# VF_BOOTSTRAP_TIMEOUT_SEC=45
# VF_VINTED_BOOTSTRAP_TIMEOUT=45

# LeBonCoin — rate limiting
# VF_LBC_RATE_PER_MIN=10
# VF_LBC_BLOCK_COOLDOWN_MIN=25
