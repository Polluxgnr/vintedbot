# --- Telegram: create a bot with @BotFather and paste the token
TELEGRAM_TOKEN=
# Optional: comma separated chat ids. Empty = the first person to send /start owns the bot.
TELEGRAM_ALLOWED_CHATS=

# --- AI via OpenRouter (https://openrouter.ai/keys). Without it the bot still works on free tiers.
OPENROUTER_API_KEY=
# Cascade models (defaults shown) - cheap -> expensive
# MODEL_TRIAGE=anthropic/claude-haiku-5.5
# MODEL_VISION=anthropic/claude-haiku-5.5
# MODEL_DEEP=anthropic/claude-sonnet-5.5
# MODEL_EXPERT=anthropic/claude-opus-5.5

# --- Vinted
# VINTED_DOMAIN=www.vinted.fr
# VINTED_MIN_REQUEST_INTERVAL=2.0
# WATCH_INTERVAL_S=120
